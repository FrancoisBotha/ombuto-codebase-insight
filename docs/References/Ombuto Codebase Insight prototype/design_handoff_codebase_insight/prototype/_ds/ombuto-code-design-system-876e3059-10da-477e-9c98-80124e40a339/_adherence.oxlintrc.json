{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|tone|state|status|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, tone, state, status, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:state|status|deps|flag)$/]",
        "message": "<Badge> kind must be one of 'state' | 'status' | 'deps' | 'flag'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|eval|yellow|orange|red|green|neutral)$/]",
        "message": "<Badge> tone must be one of 'blue' | 'eval' | 'yellow' | 'orange' | 'red' | 'green' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:queued|running|failed|completed|evaluating|resolving|merge_failed|merge_aborted|pass|fail)$/]",
        "message": "<Badge> state must be one of 'queued' | 'running' | 'failed' | 'completed' | 'evaluating' | 'resolving' | 'merge_failed' | 'merge_aborted' | 'pass' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:todo|in_progress|eval|merging|review|done)$/]",
        "message": "<Badge> status must be one of 'todo' | 'in_progress' | 'eval' | 'merging' | 'review' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|success|blue|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger' | 'success' | 'blue' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|dialog)$/]",
        "message": "<Button> size must be one of 'md' | 'dialog'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|key|ref|className|style|children)$/]",
        "message": "<ChipButton> doesn't accept that prop. Declared props: kind, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipButton'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:start|cancel|skip)$/]",
        "message": "<ChipButton> kind must be one of 'start' | 'cancel' | 'skip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<CountPill> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|size|title|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, icon, size, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:approve|reject|archive|changes|summary|failed|info|square|doctor|scheduled)$/]",
        "message": "<IconButton> variant must be one of 'approve' | 'reject' | 'archive' | 'changes' | 'summary' | 'failed' | 'info' | 'square' | 'doctor' | 'scheduled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='KanbanColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|columnId|tickets|renderCard|children|key|ref|className|style|children)$/]",
        "message": "<KanbanColumn> doesn't accept that prop. Declared props: title, columnId, tickets, renderCard, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='KanbanColumn'] > JSXAttribute[name.name='columnId'] > Literal[value!=/^(?:todo|in_progress|test|eval|merging|review|done)$/]",
        "message": "<KanbanColumn> columnId must be one of 'todo' | 'in_progress' | 'test' | 'eval' | 'merging' | 'review' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|open|onClose|footer|children|width|inline|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, open, onClose, footer, children, width, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|size|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Select> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|activeView|collapsed|autoOn|onModeChange|onViewChange|onToggleCollapse|onToggleAuto|children|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: mode, activeView, collapsed, autoOn, onModeChange, onViewChange, onToggleCollapse, onToggleAuto, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:plan|build|review)$/]",
        "message": "<Sidebar> mode must be one of 'plan' | 'build' | 'review'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:path|branch|modified|untracked|ahead|project|build|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: path, branch, modified, untracked, ahead, project, build."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticket'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|assignee|agent|deps|blocked|state|stateLabel|evalFailed|testFailed|agentName|key|ref|className|style|children)$/]",
        "message": "<Ticket> doesn't accept that prop. Declared props: id, title, assignee, agent, deps, blocked, state, stateLabel, evalFailed, testFailed, agentName."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticket'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:queued|running|failed|completed|evaluating|resolving|merge_failed|merge_aborted)$/]",
        "message": "<Ticket> state must be one of 'queued' | 'running' | 'failed' | 'completed' | 'evaluating' | 'resolving' | 'merge_failed' | 'merge_aborted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|logoSrc|color|key|ref|className|style|children)$/]",
        "message": "<TitleBar> doesn't accept that prop. Declared props: title, logoSrc, color."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
